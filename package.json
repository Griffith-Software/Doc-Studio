{
  "name": "docstudio",
  "version": "1.0.1",
  "description": "View, edit and convert Markdown, PDF, documents, spreadsheets and presentations.",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "main": "main.js",
  "author": {
    "name": "Griffith Software",
    "email": "hello@griffith.software",
    "url": "https://griffith.software"
  },
  "scripts": {
    "start": "electron .",
    "test": "node tests/run.js",
    "predist": "node tests/check-syntax.js && node tools/make-ai-packages.js && node tools/make-icon-handler.js",
    "predist:dir": "node tests/check-syntax.js && node tools/make-ai-packages.js && node tools/make-icon-handler.js",
    "dist": "electron-builder --win nsis",
    "dist:dir": "electron-builder --win dir",
    "bundle": "npm run bundle:formula && npm run bundle:pdf",
    "bundle:pdf": "esbuild src/pdf-entry.js --bundle --minify --format=iife --global-name=DDPdf --platform=browser --target=chrome120 --outfile=renderer/vendor/pdf.js --legal-comments=none --metafile=build/pdf-meta.json --log-level=error && node build/make-notices.js build/pdf-meta.json pdf",
    "bundle:formula": "esbuild src/formula-entry.js --bundle --minify --format=iife --global-name=DDFormula --platform=browser --target=chrome120 --outfile=renderer/vendor/formula.js --legal-comments=none --metafile=build/formula-meta.json && node build/make-notices.js"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "docx": "^9.11.0",
    "docx-preview": "^0.4.1",
    "dompurify": "^3.4.17",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "marked": "^18.1.1",
    "rtf.js": "^3.0.9",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "word-extractor": "^1.0.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@formulajs/formulajs": "^4.6.1",
    "@pdf-lib/fontkit": "^1.1.1",
    "electron": "^34.5.8",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.28.2",
    "fast-formula-parser": "^1.0.19",
    "onnxruntime-web": "^1.30.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "qrcode-generator": "^1.4.4"
  },
  "build": {
    "appId": "software.griffith.docstudio",
    "productName": "Doc Studio",
    "copyright": "Copyright (c) 2026 Richard Griffith (d/b/a Griffith Software)",
    "afterSign": "packaging/afterSign.js",
    "publish": null,
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "convert.js",
      "preload.js",
      "shell-icons.js",
      "ai/**/*",
      "phone.js",
      "phone-page.html",
      "renderer/**/*",
      "package.json",
      "!**/*.map",
      "!**/*.d.ts",
      "!**/*.md",
      "build/icon.png",
      "!build/*.js"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "license": "LICENSE",
      "uninstallDisplayName": "${productName}",
      "artifactName": "DocStudio-Setup-${version}.${ext}",
      "include": "build/installer.nsh"
    },
    "extraResources": [
      {
        "from": "build/ai",
        "to": "ai"
      },
      {
        "from": "build/filetypes",
        "to": "filetypes",
        "filter": [
          "*.ico"
        ]
      },
      {
        "from": "build/iconhandler",
        "to": "iconhandler",
        "filter": [
          "*.dll"
        ]
      }
    ],
    "extraFiles": [
      {
        "from": "LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "NOTICE",
        "to": "NOTICE"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      }
    ]
  }
}
